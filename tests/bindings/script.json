{
  "about": "Played through every delivery against integrations-sim. Each step's result, with every 'message' field removed, must equal 'expect' exactly. '$name' is replaced by a simulator port or a saved device id. A 'stream' step watches a stream: with 'expect', opening it must fail with that error; otherwise 'frames' frames must arrive within 5 s, each of 'format', starting with the JPEG marker FF D8, with rising sequence numbers, and the stream is then closed. An 'event' step takes queued events, discarding others, until 'count' (1 if absent) of them have every field of 'match' equal, within 5 s. An 'update_settings' step merges 'settings' into an open device's (update_settings in every delivery) and its result must equal 'expect'.",
  "steps": [
    { "op": "catalog", "path": "devices.kramer-p3000.vendor", "expect": "Kramer Electronics" },

    { "op": "open", "save": "o",
      "request": { "device": "osc-listener", "model": "generic", "port": "$osc",
                   "settings": { "bind_address": "127.0.0.1" } } },
    { "op": "wait", "device": "$o", "path": "connection.status", "equals": "connected" },
    { "op": "execute", "device": "$o", "command": "send",
      "params": { "to": "$osc_address", "address": "/script/press", "args": [1] },
      "expect": { "ok": { "kind": "unverified" } } },
    { "op": "execute", "device": "$o", "command": "send",
      "params": { "to": "$osc_address", "address": "/script/press", "args": [1] },
      "expect": { "ok": { "kind": "unverified" } } },
    { "op": "event", "count": 2,
      "match": { "event": "message", "device": "$o", "address": "/script/press", "types": "i", "args": [1],
                 "source": "$osc_address" } },
    { "op": "close", "device": "$o" },

    { "op": "open", "save": "k",
      "request": { "device": "kramer-p3000", "model": "p3000-generic", "host": "127.0.0.1", "port": "$kramer" } },
    { "op": "wait", "device": "$k", "path": "connection.status", "equals": "connected" },

    { "op": "execute", "device": "$k", "command": "route_video", "params": { "input": 3, "output": 2 },
      "expect": { "ok": { "kind": "ack" } } },
    { "op": "execute", "device": "$k", "command": "route_video", "params": { "input": 9, "output": 2 },
      "expect": { "error": { "error": "device_error" } } },
    { "op": "execute", "device": "$k", "command": "get_model", "params": {},
      "expect": { "ok": { "kind": "value", "value": "VS-88UT" } } },
    { "op": "execute", "device": "$k", "command": "route_video", "params": { "input": -1, "output": 1 },
      "expect": { "error": { "error": "invalid_params" } } },
    { "op": "execute", "device": "$k", "command": "no_such_command", "params": {},
      "expect": { "error": { "error": "unknown_command", "command": "no_such_command" } } },
    { "op": "update_settings", "device": "$k", "settings": {}, "expect": { "ok": true } },
    { "op": "execute", "device": "$k", "command": "get_model", "params": {},
      "expect": { "ok": { "kind": "value", "value": "VS-88UT" } } },

    { "op": "open", "request": { "device": "no-such-device", "model": "x", "host": "127.0.0.1" },
      "expect": { "error": { "error": "unknown_device", "device": "no-such-device" } } },

    { "op": "open", "save": "d",
      "request": { "device": "sennheiser-digital-6000", "model": "em-6000", "host": "127.0.0.1", "port": "$d6000" } },
    { "op": "wait", "device": "$d", "path": "connection.status", "equals": "connected" },
    { "op": "wait", "device": "$d", "path": "state.channels.1.name", "equals": "Mic 1" },
    { "op": "wait", "device": "$d", "path": "state.channels.2.frequency_khz", "equals": 606800 },

    { "op": "execute", "device": "$d", "command": "mute", "params": { "channel": 2, "muted": true },
      "expect": { "ok": { "kind": "ack" } } },
    { "op": "wait", "device": "$d", "path": "state.channels.2.mute", "equals": true },
    { "op": "execute", "device": "$d", "command": "set_frequency", "params": { "channel": 1, "frequency_khz": 606000 },
      "expect": { "ok": { "kind": "unverified" } } },

    { "op": "open", "save": "s",
      "request": { "device": "http-snapshot", "model": "generic", "host": "127.0.0.1", "port": "$snapshot",
                   "settings": { "path": "/snapshot.jpg", "interval_ms": 50 } } },
    { "op": "wait", "device": "$s", "path": "connection.status", "equals": "connected" },
    { "op": "stream", "device": "$s", "stream": "live", "frames": 3, "format": "jpeg" },
    { "op": "stream", "device": "$s", "stream": "no_such_stream",
      "expect": { "error": { "error": "unknown_stream", "stream": "no_such_stream" } } },
    { "op": "update_settings", "device": "$s", "settings": { "no_such_setting": 1 },
      "expect": { "error": { "error": "invalid_settings" } } },
    { "op": "update_settings", "device": "$s", "settings": { "interval_ms": 100 }, "expect": { "ok": true } },
    { "op": "wait", "device": "$s", "path": "connection.status", "equals": "connected" },
    { "op": "stream", "device": "$s", "stream": "live", "frames": 2, "format": "jpeg" },
    { "op": "close", "device": "$s" },
    { "op": "update_settings", "device": "$s", "settings": { "interval_ms": 50 },
      "expect": { "error": { "error": "closed" } } },
    { "op": "stream", "device": "$s", "stream": "live",
      "expect": { "error": { "error": "closed" } } },

    { "op": "close", "device": "$k" },
    { "op": "execute", "device": "$k", "command": "get_model", "params": {},
      "expect": { "error": { "error": "closed" } } },
    { "op": "close", "device": "$d" }
  ]
}
