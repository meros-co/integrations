{
  "about": "Played through every delivery against integrations-sim. Each step's result, with every 'message' field removed, must equal 'expect' exactly. '$name' is replaced by a simulator port or a saved device id.",
  "steps": [
    { "op": "catalog", "path": "devices.kramer-p3000.vendor", "expect": "Kramer Electronics" },

    { "op": "open", "save": "k",
      "request": { "device": "kramer-p3000", "model": "p3000-generic", "host": "127.0.0.1", "port": "$kramer" } },
    { "op": "wait", "device": "$k", "path": "connection.status", "equals": "connected" },

    { "op": "execute", "device": "$k", "command": "route_video", "params": { "input": 3, "output": 2 },
      "expect": { "ok": { "kind": "ack" } } },
    { "op": "execute", "device": "$k", "command": "route_video", "params": { "input": 9, "output": 2 },
      "expect": { "error": { "error": "device_error" } } },
    { "op": "execute", "device": "$k", "command": "get_model", "params": {},
      "expect": { "ok": { "kind": "value", "value": "VS-88UT" } } },
    { "op": "execute", "device": "$k", "command": "route_video", "params": { "input": -1, "output": 1 },
      "expect": { "error": { "error": "invalid_params" } } },
    { "op": "execute", "device": "$k", "command": "no_such_command", "params": {},
      "expect": { "error": { "error": "unknown_command", "command": "no_such_command" } } },

    { "op": "open", "request": { "device": "no-such-device", "model": "x", "host": "127.0.0.1" },
      "expect": { "error": { "error": "unknown_device", "device": "no-such-device" } } },

    { "op": "open", "save": "d",
      "request": { "device": "sennheiser-digital-6000", "model": "em-6000", "host": "127.0.0.1", "port": "$d6000" } },
    { "op": "wait", "device": "$d", "path": "connection.status", "equals": "connected" },
    { "op": "wait", "device": "$d", "path": "state.channels.1.name", "equals": "Mic 1" },
    { "op": "wait", "device": "$d", "path": "state.channels.2.frequency_khz", "equals": 606800 },

    { "op": "execute", "device": "$d", "command": "mute", "params": { "channel": 2, "muted": true },
      "expect": { "ok": { "kind": "ack" } } },
    { "op": "wait", "device": "$d", "path": "state.channels.2.mute", "equals": true },
    { "op": "execute", "device": "$d", "command": "set_frequency", "params": { "channel": 1, "frequency_khz": 606000 },
      "expect": { "ok": { "kind": "unverified" } } },

    { "op": "close", "device": "$k" },
    { "op": "execute", "device": "$k", "command": "get_model", "params": {},
      "expect": { "error": { "error": "closed" } } },
    { "op": "close", "device": "$d" }
  ]
}
