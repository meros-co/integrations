{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meros-co/integrations/schema/device-spec-1.json",
  "title": "Meros Device Spec v1 (draft)",
  "type": "object",
  "required": [
    "spec",
    "id",
    "name",
    "vendor",
    "category",
    "source",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "mixer",
        "router",
        "recorder",
        "switcher",
        "camera",
        "lighting",
        "playback",
        "wireless",
        "display",
        "other"
      ]
    },
    "implementation": {
      "enum": [
        "spec",
        "native"
      ],
      "default": "spec",
      "description": "'native' marks a device implemented as a Rust module in the core. Its commands carry no wire behaviour."
    },
    "reason": {
      "type": "string",
      "description": "Required when implementation is 'native': why the protocol cannot be expressed as data."
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "transport": {
      "$ref": "#/$defs/transport"
    },
    "settings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "int",
              "float",
              "bool",
              "enum",
              "string",
              "json"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max_length": {
            "type": "integer",
            "minimum": 1
          },
          "pattern": {
            "type": "string"
          },
          "default": {},
          "secret": {
            "type": "boolean",
            "default": false
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "on_connect": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/oscSend"
          },
          {
            "$ref": "#/$defs/httpSend"
          },
          {
            "type": "object",
            "required": [
              "send"
            ],
            "additionalProperties": false,
            "description": "A step with conditions. when_set: sent only when the named setting is non-empty, decided from configuration before connecting. after_prompt: sent only once the device has sent this text (line-tcp). refused: a reply line matching this regex is the device refusing the credential. accepted: once a reply line matches this regex, refused stops applying.",
            "properties": {
              "send": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/oscSend"
                  },
                  {
                    "$ref": "#/$defs/httpSend"
                  }
                ]
              },
              "when_set": {
                "type": "string"
              },
              "after_prompt": {
                "type": "string",
                "minLength": 1,
                "description": "line-tcp only. Literal text the device sends before this step is accepted, such as a password prompt with no line ending. Nothing is sent, and the device is not reported connected, until it arrives; without it within the timeout the connection is dropped and retried."
              },
              "refused": {
                "type": "string",
                "description": "Regex over reply lines. A match is the device refusing the credential: terminal, never retried."
              },
              "await_reply": {
                "type": "boolean",
                "default": false,
                "description": "On a transport whose device replies: queue the step like a query, so its reply is consumed and no command goes ahead of it."
              },
              "accepted": {
                "type": "string",
                "description": "With refused: regex over reply lines. Once a line matches, the device has accepted the login and refused no longer applies."
              }
            }
          }
        ]
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "commands": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/command"
      }
    },
    "codes": {
      "type": "object",
      "description": "Device-wide map of numeric response code to failure message, used with expect.code_range.",
      "propertyNames": {
        "pattern": "^[0-9]+$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "conversions": {
      "type": "object",
      "description": "Named piecewise-linear conversions between a wire value and the value an operator uses (a fader law). Used in templates as {x:to.<name>} (value to wire) and {x:from.<name>} (wire to value), and by expect.convert (SPEC.md §4).",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "points"
        ],
        "additionalProperties": false,
        "properties": {
          "points": {
            "type": "array",
            "minItems": 2,
            "description": "[wire, value] pairs joined by straight lines; wire strictly rising, value strictly rising or strictly falling. Values outside the points do not convert.",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "quirks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quirk"
      }
    },
    "streams": {
      "type": "object",
      "description": "Continuous media a native module publishes, such as a camera's live view, keyed by stream name. Consumers watch a stream by name; frames are delivered outside the event queue, newest only. See SPEC.md, Native modules, Streams.",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "jpeg"
            ],
            "description": "The encoding of every frame: jpeg is one complete JPEG image (ITU-T T.81) per frame."
          },
          "summary": {
            "type": "string"
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "The models that have the stream; every model when absent."
          }
        }
      }
    },
    "state": {
      "type": "object",
      "description": "Telemetry fields the device reports, keyed by dotted path; '*' stands for a channel number.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "int",
              "float",
              "bool",
              "string",
              "array",
              "object"
            ]
          },
          "unit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the device's own messages become state (SPEC.md §8).",
      "properties": {
        "subscribe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "send"
          ],
          "properties": {
            "send": {
              "oneOf": [
                {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/oscSend"
                    },
                    {
                      "$ref": "#/$defs/httpSend"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/oscSend"
                      },
                      {
                        "$ref": "#/$defs/httpSend"
                      }
                    ]
                  }
                }
              ]
            },
            "every_ms": {
              "type": "integer",
              "minimum": 100,
              "description": "Sent again at this interval (a subscription that expires, or a poll)."
            }
          }
        },
        "poll": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "send"
          ],
          "properties": {
            "send": {
              "oneOf": [
                {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/oscPollSend"
                    },
                    {
                      "$ref": "#/$defs/httpSend"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/oscPollSend"
                      },
                      {
                        "$ref": "#/$defs/httpSend"
                      }
                    ]
                  }
                }
              ]
            },
            "every_ms": {
              "type": "integer",
              "minimum": 100,
              "description": "Sent again at this interval (a subscription that expires, or a poll)."
            }
          }
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "match": {
                "type": "string",
                "description": "Regex over the whole message; captures are {1}, {2}, ..."
              },
              "header": {
                "type": "string",
                "description": "Regex over a block's first line."
              },
              "each_line": {
                "type": "string",
                "description": "With header: regex applied to every following line."
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "State path."
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "map": {
                          "type": "object"
                        }
                      }
                    }
                  ]
                },
                "description": "With header: 'name: value' lines to state paths."
              },
              "address": {
                "type": "string",
                "description": "Regex over an OSC address; arguments are {arg0}, {arg1}, ..."
              },
              "json_arg": {
                "type": "integer",
                "minimum": 0,
                "description": "With address and json: the string argument holding JSON (default 0)."
              },
              "state": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Value template over the rule's captures."
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "value",
                        "map"
                      ],
                      "properties": {
                        "value": {
                          "type": "string"
                        },
                        "map": {
                          "type": "object",
                          "description": "Wire text to state value; wire values not listed are not assigned."
                        }
                      }
                    }
                  ]
                },
                "description": "State path template to value."
              },
              "path": {
                "type": "string",
                "description": "Regex over an HTTP request's path and query; the rule handles its reply."
              },
              "json": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "With path: names for values taken from a JSON reply, by JSON path. With address: from the JSON in the string argument at json_arg. With json_match alone: from the JSON message."
              },
              "xml_each": {
                "type": "string",
                "description": "With path: an XML element name; each such element in the reply is a match, its attributes the captures."
              },
              "json_each": {
                "type": "string",
                "description": "With path or json_match, and json: a JSON path to an array; the rule matches once per element, json paths relative to it."
              },
              "arg_types": {
                "type": "string",
                "pattern": "^[ifsbhdTFN]*$",
                "description": "With address: the message's OSC type tags must be exactly these (without the comma), for a device that sends different shapes on one address."
              },
              "json_match": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string"
                },
                "description": "JSON path to an RE2-safe regex its value must match (a string as is, anything else as compact JSON). Alone: a JSON message on a websocket, an event stream, or a line of a line transport. With path: the JSON reply must match too. Captures are {1}, {2}, ... across the regexes in order, after the path's."
              },
              "request_match": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string"
                },
                "description": "With path: JSON path to an RE2-safe regex the JSON body of the request the reply answers must match, so replies sharing one path (JSON-RPC) can be told apart. Its captures come after the path's and before json_match's."
              }
            },
            "oneOf": [
              {
                "required": [
                  "match",
                  "state"
                ]
              },
              {
                "required": [
                  "address",
                  "state"
                ]
              },
              {
                "required": [
                  "header",
                  "each_line",
                  "state"
                ]
              },
              {
                "required": [
                  "header",
                  "fields"
                ]
              },
              {
                "required": [
                  "path",
                  "json",
                  "state"
                ]
              },
              {
                "required": [
                  "path",
                  "xml_each",
                  "state"
                ]
              },
              {
                "required": [
                  "json_match",
                  "state"
                ],
                "not": {
                  "required": [
                    "path"
                  ]
                }
              }
            ]
          }
        },
        "websocket": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "description": "A websocket opened beside the transport, for a device that takes commands one way (REST) and pushes state on a websocket. Its messages go through the update rules; it is reopened with backoff when it closes.",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Defaults to the transport's port."
            },
            "scheme": {
              "description": "ws or wss, or {setting: name} naming an enum setting whose values are ws and wss.",
              "oneOf": [
                {
                  "enum": [
                    "ws",
                    "wss"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "setting"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "setting": {
                      "type": "string"
                    }
                  }
                }
              ],
              "default": "ws"
            },
            "subprotocol": {
              "type": "string",
              "description": "Sent as Sec-WebSocket-Protocol."
            },
            "accept_invalid_certs": {
              "type": "boolean",
              "description": "Over wss, accept a certificate that does not chain to a trusted root, such as a device's self-signed one. The connection is encrypted; the device is not authenticated. Defaults to the http transport's accept_invalid_certs."
            },
            "send": {
              "description": "Text messages (templates over settings) sent each time the websocket opens: the subscriptions.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "socketio": {
              "description": "The websocket speaks Socket.IO over Engine.IO (path usually /socket.io/): the core adds EIO and transport to the query, joins the namespace when the server opens, answers pings, sends each send item as an event (a JSON array, [\"name\", data]), and gives each event to the json_match rules as {\"event\", \"data\", \"args\"}.",
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "engine_io": {
                      "enum": [
                        3,
                        4
                      ],
                      "default": 4,
                      "description": "4 for Socket.IO 3 and 4 (the server pings), 3 for Socket.IO 2 (the client pings)."
                    },
                    "namespace": {
                      "type": "string",
                      "pattern": "^/",
                      "default": "/"
                    }
                  }
                }
              ]
            }
          }
        },
        "sse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "description": "A server-sent event stream opened beside an http transport, with the transport's credential, for a device that pushes changes as text/event-stream. Each event goes to the json_match rules as {\"event\": name, \"data\": data} (data parsed where it is JSON) and its data to the text rules; it is reopened with backoff when it closes.",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      }
    },
    "extension": {
      "enum": [
        "panasonic-update-notification",
        "aja-config-events",
        "resolume-push"
      ],
      "description": "A native addition to a spec-driven device, for what the format cannot express. Named here so it is never hidden."
    }
  },
  "$defs": {
    "transport": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "line-tcp"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "framing": {
              "enum": [
                "delimited",
                "terminated",
                "block",
                "length-prefixed"
              ]
            },
            "open": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "terminator": {
              "enum": [
                "cr",
                "crlf",
                "lf"
              ]
            },
            "encoding": {
              "enum": [
                "ascii",
                "utf-8"
              ],
              "default": "ascii"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "reply": {
              "enum": [
                "expected",
                "none"
              ],
              "default": "expected"
            },
            "reply_framing": {
              "enum": [
                "line",
                "block",
                "headed-block",
                "terminated"
              ],
              "description": "How a reply is delimited. Defaults to 'block' for framing: block, otherwise 'line'. 'terminated' ends a message at any of reply_terminators, with no line ending needed."
            },
            "reply_terminators": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "With reply_framing: terminated. A message runs up to and including the first of these; surrounding spaces and line endings are dropped."
            },
            "reply_match": {
              "type": "string",
              "description": "RE2-safe regex. A message matching it is a command reply; any other message is unsolicited."
            },
            "probe": {
              "type": "string"
            }
          },
          "required": [
            "port",
            "framing"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "line-udp"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "terminator": {
              "enum": [
                "none",
                "cr",
                "crlf",
                "lf"
              ],
              "default": "none"
            },
            "encoding": {
              "enum": [
                "ascii",
                "utf-8"
              ],
              "default": "ascii"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "reply": {
              "enum": [
                "to-source",
                "none"
              ],
              "default": "none"
            },
            "listen_port": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "object",
                  "required": [
                    "setting"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "setting": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "probe": {
              "type": "string"
            }
          },
          "required": [
            "port"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "osc-udp"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "reply": {
              "enum": [
                "to-source",
                "none"
              ],
              "default": "none"
            },
            "listen_port": {
              "description": "Receive on this fixed local port, shared between devices and routed by source address, for devices that send to a configured destination. A port, or {setting: name} naming an integer setting; an empty setting means no fixed port.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "object",
                  "required": [
                    "setting"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "setting": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "probe": {
              "type": "string"
            }
          },
          "required": [
            "port"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "osc-tcp"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "framing": {
              "enum": [
                "slip",
                "length-prefixed"
              ]
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "probe": {
              "type": "string"
            }
          },
          "required": [
            "port",
            "framing"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "http"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "scheme": {
              "description": "http or https, or {setting: name} naming an enum setting whose values are http and https, for devices the operator can switch.",
              "oneOf": [
                {
                  "enum": [
                    "http",
                    "https"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "setting"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "setting": {
                      "type": "string"
                    }
                  }
                }
              ],
              "default": "http"
            },
            "refusal_status": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 400,
                "maximum": 499
              },
              "default": [
                401,
                403
              ],
              "description": "HTTP statuses that mean the credential was refused, for devices that use 403 for other errors."
            },
            "accept_invalid_certs": {
              "type": "boolean",
              "default": false,
              "description": "Over HTTPS, accept a certificate that does not chain to a trusted root, such as a device's self-signed one. The connection is encrypted; the device is not authenticated."
            },
            "auth": {
              "enum": [
                "none",
                "basic",
                "digest",
                "bearer",
                "query-token"
              ],
              "default": "none"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "probe": {
              "$ref": "#/$defs/httpSend"
            }
          },
          "required": [
            "port"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "ws"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "scheme": {
              "description": "ws or wss, or {setting: name} naming an enum setting whose values are ws and wss.",
              "oneOf": [
                {
                  "enum": [
                    "ws",
                    "wss"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "setting"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "setting": {
                      "type": "string"
                    }
                  }
                }
              ],
              "default": "ws"
            },
            "subprotocol": {
              "type": "string",
              "description": "Sent as Sec-WebSocket-Protocol."
            },
            "accept_invalid_certs": {
              "type": "boolean",
              "default": false,
              "description": "Over wss, accept a certificate that does not chain to a trusted root, such as a device's self-signed one. The connection is encrypted; the device is not authenticated."
            },
            "auth": {
              "enum": [
                "none",
                "basic",
                "bearer"
              ],
              "default": "none",
              "description": "Credential on the opening request, from the username and password, or token, settings. A 401 or 403 answer is terminal, as for http."
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "reply": {
              "enum": [
                "expected",
                "none"
              ],
              "default": "expected"
            },
            "reply_match": {
              "type": "string",
              "description": "RE2-safe regex. For replies taken in order: a message not matching it is never taken as a reply."
            },
            "probe": {
              "type": "string"
            }
          },
          "required": [
            "port",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "name",
        "supports",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "channels": {
          "type": "integer",
          "minimum": 0
        },
        "dcas": {
          "type": "integer",
          "minimum": 0
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allow-list of command keys. A command absent here MUST be refused for this model."
        },
        "verification": {
          "enum": [
            "none",
            "bench",
            "field"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "command": {
      "type": "object",
      "description": "'send' is required for spec-driven devices and forbidden for native ones; tools/validate.py enforces this.",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/param"
          }
        },
        "send": {
          "oneOf": [
            {
              "type": "string",
              "description": "line-tcp payload template"
            },
            {
              "$ref": "#/$defs/oscSend"
            },
            {
              "$ref": "#/$defs/httpSend"
            },
            {
              "type": "array",
              "minItems": 1,
              "description": "Ordered sequence; all messages must succeed.",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/oscSend"
                  },
                  {
                    "$ref": "#/$defs/httpSend"
                  }
                ]
              }
            }
          ]
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "returns": {
          "enum": [
            "ack",
            "value",
            "fields",
            "text",
            "none"
          ],
          "default": "ack"
        }
      }
    },
    "param": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "int",
            "float",
            "bool",
            "enum",
            "string",
            "json"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_length": {
          "type": "integer",
          "minimum": 1
        },
        "pattern": {
          "type": "string"
        },
        "default": {},
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "oscSend": {
      "type": "object",
      "required": [
        "address"
      ],
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^/"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "int",
                  "float",
                  "string",
                  "blob"
                ]
              }
            }
          }
        }
      }
    },
    "oscPollSend": {
      "type": "object",
      "required": [
        "address"
      ],
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^/"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "int",
                  "float",
                  "string",
                  "blob"
                ]
              }
            }
          }
        },
        "reply_address": {
          "type": "string",
          "description": "Telemetry poll only: RE2-safe regex over the address the device answers on, for a query answered on another address (ETC Eos: /eos/get/... on /eos/out/get/...)."
        }
      }
    },
    "httpSend": {
      "type": "object",
      "required": [
        "method",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "raw_query": {
          "type": "string",
          "description": "Sent verbatim, never re-encoded. For positional CGI arguments."
        },
        "query": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "raw_query",
          "query"
        ]
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "contains": {
          "type": "string"
        },
        "not_contains": {
          "type": "string"
        },
        "matches": {
          "type": "string",
          "description": "RE2-safe regex; capture group 1 is the returned value."
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "json_path": {
          "type": "string",
          "description": "JSON path into the reply: the HTTP body, or for OSC the string argument at arg."
        },
        "json_equals": {
          "type": "object",
          "minProperties": 1,
          "description": "JSON path to the value it must hold, in the same JSON as json_path; any other value fails the command."
        },
        "code_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer"
          },
          "description": "Inclusive success range for a leading numeric response code."
        },
        "address": {
          "type": "string",
          "pattern": "^/",
          "description": "OSC only. Templated address the reply must carry."
        },
        "arg": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "OSC only. Index of the reply argument returned as the value."
        },
        "reply_json": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          },
          "description": "Websocket only. JSON path to a template: the reply is the message whose values at these paths equal the rendered templates (a request id, or the parameter asked for). Without it, the next message is the reply."
        },
        "convert": {
          "type": "string",
          "description": "The name of a conversion: the returned value is converted from the wire."
        }
      }
    },
    "quirk": {
      "type": "object",
      "required": [
        "models",
        "severity",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Model ids, or the single entry 'all'."
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
